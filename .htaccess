# ปิดการแสดงรายชื่อไฟล์ในไดเรกทอรี
Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8

# ป้องกันการเข้าถึงไฟล์สำคัญและไฟล์ตั้งค่าโดยตรง
<FilesMatch "^(config\.php|config\.example\.php|router\.php|database-mysql\.sql|\.gitignore|\.htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ห้ามเข้าถึงโฟลเดอร์ scripts/ ผ่านเว็บเด็ดขาด (อนุญาตเฉพาะ CLI)
  RewriteRule ^scripts(/|$) - [F,L]

  # ส่งต่อ Header Authorization (ถ้ามี) และส่ง /api/... ทั้งหมดไปที่ api.php
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^api(?:/(.*))?$ api.php [QSA,L]
</IfModule>
